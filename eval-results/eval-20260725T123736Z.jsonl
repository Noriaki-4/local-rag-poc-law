-article-80-paragraph-1-item-5", "law-419M60000002052-article-110", "law-419M60000002052-article-111", "law-419M60000002052-article-141", "law-419M60000002052-article-25", "law-419M60000002052-article-3", "law-419M60000002052-article-47"], "retrievedGraphEdgeIds": ["edge-law-419M60000002052-article-79-paragraph-4-references-article-82", "edge-law-419M60000002052-article-79-paragraph-4-references-article-92_2", "edge-law-419M60000002052-article-79-paragraph-6-item-2-references-article-80", "edge-law-419M60000002052-article-80-paragraph-1-item-1-references-article-79", "edge-law-419M60000002052-article-83-paragraph-1-references-article-82", "edge-law-419M60000002052-article-83-paragraph-1-item-1-references-article-82", "edge-law-419M60000002052-article-86-paragraph-1-references-article-83", "edge-law-419M60000002052-article-86-paragraph-1-item-4-references-article-83", "edge-law-419M60000002052-article-86-paragraph-1-item-9-references-article-83", "edge-law-419M60000002052-article-86-paragraph-1-item-11-references-article-16_2", "edge-law-419M60000002052-article-79-has-content-unit-article-79-paragraph-1", "edge-law-419M60000002052-article-79-has-content-unit-article-79-paragraph-2", "edge-law-419M60000002052-article-79-has-content-unit-article-79-paragraph-3", "edge-law-419M60000002052-article-79-has-content-unit-article-79-paragraph-4", "edge-law-419M60000002052-article-79-has-content-unit-article-79-paragraph-5", "edge-law-419M60000002052-article-79-has-content-unit-article-79-paragraph-6", "edge-law-419M60000002052-article-79-paragraph-6-has-content-unit-article-79-paragraph-6-item-1", "edge-law-419M60000002052-article-79-paragraph-6-has-content-unit-article-79-paragraph-6-item-2", "edge-law-419M60000002052-article-79-paragraph-6-has-content-unit-article-79-paragraph-6-item-3", "edge-law-419M60000002052-article-79-has-content-unit-article-79-paragraph-7", "edge-law-419M60000002052-article-80-paragraph-1-item-5-references-article-110", "edge-law-419M60000002052-article-80-paragraph-1-item-5-references-article-111", "edge-law-419M60000002052-article-80-paragraph-1-item-5-references-article-141", "edge-law-419M60000002052-article-80-paragraph-1-item-5-references-article-25", "edge-law-419M60000002052-article-80-paragraph-1-item-5-references-article-3", "edge-law-419M60000002052-article-80-paragraph-1-item-5-references-article-47"], "citations": [{"documentId": "guidance-fsa-financial-instruments-business", "contentUnitId": "guidance-fsa-financial-instruments-business-page-139-chunk-316", "title": "金融商品取引業者等向けの総合的な監督指針", "heading": "金融商品取引業者等向けの総合的な監督指針 p.139", "sourceObjectUri": "minio://knowledge-root/source-documents/external-guidance/fsa-financial-instruments-business-supervisory-guidelines.pdf", "sourcePage": 139, "text": "（２）有価証券の受渡状況その他の必要情報の通知に係る留意事項\n証券会社等が、次に掲げる事項を顧客に適切に通知（下記④については顧客の同意した 方法による場合を含む。 ）していない場合は、金商業等府令第 123 条第１項第８号の規定 「顧客の有価証券の売買その他の取引等に関し、受渡状況その他の顧客に必要な情報を適 切に通知していないと認められる状況」に該当するものとする。\n① 金商法第 37 条の４に規定する契約締結時等の情報の提供をすべき事項\n② 顧客が国債の入札前取引を行った場合であって、当該国債に係る入札が成立した後 においては、当該取引に係る銘柄、単価及び金額並びに当該取引の約定の際に取引報 告書において通知した事項（償還予定日及び約定利回りを除く。 ）\n③ 顧客が国債の入札前取引を行った場合であって、当該取引契約に係る停止条件が不 成就となった後においては、当該事実及び当該取引の成否に係る事項（通知しないこ とについて顧客から同意を得た場合を除く。 ）\n④ 上記①から③までに掲げるもののほか、金銭若しくは有価証券の受渡しに関する事 項（ただし、金融機関を通じて金銭の受渡しを行う場合、振替決済により有価証券の 受渡しを行う場合等、顧客との間で直接金銭又は有価証券の受渡しを行わない場合に おける当該受渡しに関する事項を除く。 ）"}, {"documentId": "law-419M60000002052", "contentUnitId": "law-419M60000002052-article-123-paragraph-1-item-8", "title": "金融商品取引業等に関する内閣府令", "heading": "第百二十三条 （業務の運営の状況が公益に反し又は投資者の保護に支障を生ずるおそれがあるもの） 第1項第8号", "sourceObjectUri": "https://laws.e-gov.go.jp/api/1/lawdata/419M60000002052", "sourcePage": null, "text": "法第四十条第二号に規定する内閣府令で定める状況は、次に掲げる状況とする。\n第8号　顧客の有価証券の売買その他の取引等に関し、受渡状況その他の顧客に必要な情報を適切に通知していないと認められる状況"}, {"documentId": "guidance-fsa-financial-instruments-business", "contentUnitId": "guidance-fsa-financial-instruments-business-page-320-chunk-700", "title": "金融商品取引業者等向けの総合的な監督指針", "heading": "金融商品取引業者等向けの総合的な監督指針 p.320", "sourceObjectUri": "minio://knowledge-root/source-documents/external-guidance/fsa-financial-instruments-business-supervisory-guidelines.pdf", "sourcePage": 320, "text": "（１）有価証券の受渡状況その他の必要情報の通知に係る留意事項\nみなし有価証券販売業者等（金商法第 28 条第２項第１号に規定する行為を業として行う 者（以下「自己募集業者」という。）、同項第２号に規定する行為を業として行う者（以 下「みなし有価証券販売業者」という。）、又は金商法第 29 条の５第２項の規定により第 二種金融商品取引業とみなされる業務（以下「みなし第二種金融商品取引業」という。以 下同じ。）を行う者をいう。）が、次に掲げる事項を顧客に適切に通知していない場合は、 金商業等府令第 123 条第１項第８号の規定「顧客の有価証券の売買その他の取引等に関し、 受渡状況その他の顧客に必要な情報を適切に通知していないと認められる状況」に該当す\nるものとする。\n① 金商法第 37\n条の４に規定する契約締結時の情報の提供をすべき事項\n② 金商業等府令第 108 条第１項各号に掲げる取引残高報告書に記載すべき事項\n③ 上記①及び②に掲げるもののほか、金銭若しくは有価証券の受渡しに関する事項 （ただし、金融機関を通じて金銭の受渡しを行う場合、振替決済により有価証券の受 渡しを行う場合等、顧客との間で直接金銭又は有価証券の受渡しを行わない場合にお ける当該受渡しに関する事項を除く。 ）"}, {"documentId": "law-419M60000002052", "contentUnitId": "law-419M60000002052-article-83-paragraph-2", "title": "金融商品取引業等に関する内閣府令", "heading": "第八十三条 （有価証券の売買その他の取引に係る契約締結前交付書面の共通記載事項） 第2項", "sourceObjectUri": "https://laws.e-gov.go.jp/api/1/lawdata/419M60000002052", "sourcePage": null, "text": "２一の有価証券の売買その他の取引について二以上の金融商品取引業者等（金融サービス仲介業者を含む。）が法第三十七条の三第一項（金融サービスの提供及び利用環境の整備等に関する法律第三十一条第二項において準用する場合を含む。以下この項において同じ。）の規定により顧客に対し第七十九条第一項又は第六項に規定する方法による当該各項に規定する情報の提供（金融サービス仲介業者にあっては、金融サービス仲介業者等に関する内閣府令（令和三年内閣府令第三十五号）第八十八条第一項に規定する方法による同項に規定する情報の提供）を行わなければならない場合において、いずれか一の金融商品取引業者等（金融サービス仲介業者を含む。）が法第三十七条の三第一項の規定により当該顧客に対し第七十九条第一項又は第六項に規定する方法による前項各号に掲げる事項の提供（金融サービス仲介業者にあっては、同令第八十八条第一項に規定する方法による同項に規定する情報及び前項各号に掲げる事項の提供）を行ったときは、他の金融商品取引業者等は、同項の規定にかかわらず、同項各号に掲げる事項を提供することを要しない。"}, {"documentId": "law-419M60000002052", "contentUnitId": "law-419M60000002052-article-110-paragraph-1-item-2", "title": "金融商品取引業等に関する内閣府令", "heading": "第百十条 （契約締結時等の情報の提供を要しない場合） 第1項第2号", "sourceObjectUri": "https://laws.e-gov.go.jp/api/1/lawdata/419M60000002052", "sourcePage": null, "text": "金融商品取引契約が成立したとき、又は第九十八条第一号若しくは第二号に掲げるときにおける法第三十七条の四ただし書に規定する内閣府令で定める場合は、次に掲げる場合とする。\n第2号　次に掲げる取引に係る金融商品取引契約が成立した場合であって、契約するごとに当該取引の条件を記載した契約書を交付し、又は当該契約書に記載すべき事項を電磁的方法により提供する（顧客から当該契約書の交付の請求があった場合を除く。）ものであるとき。債券等（法第二条第一項第一号から第五号まで及び第十五号に掲げる有価証券（資産の流動化に関する法律に規定する転換特定社債券及び新優先出資引受権付特定社債券並びに新株予約権付社債券を除く。イにおいて同じ。）、同項第十七号に掲げる有価証券（同項第一号から第五号まで及び第十五号に掲げる有価証券の性質を有するものに限る。）並びに令第一条第一号に掲げる有価証券をいう。以下この号において同じ。）の買戻条件付売買（買戻価格があらかじめ定められているもの又は約定時において買戻日が定められていないものであって、買戻日を定めることにより買戻価格を定めることができるものをいう。）債券等の売戻条件付売買（売戻価格があらかじめ定められているもの又は約定時において売戻日が定められていないものであって、売戻日を定めることにより売戻価格を定めることができるものをいう。）債券等の売買のうち約定日から受渡しの日までの期間が一月以上となる取引選択権付債券売買店頭デリバティブ取引有価証券の売付けの媒介、取次ぎ又は代理（当該金融商品取引契約に係る顧客が当該有価証券の発行者又は所有者である場合に限る。）有価証券の買付けの媒介又は代理（公開買付者を相手方として公開買付けに係る有価証券の買付けの媒介又は代理を行う場合に限る。）有価証券の引受け有価証券の募集若しくは売出しの取扱い若しくは私募の取扱い又は特定投資家向け売付け勧誘等の取扱い（当該金融商品取引契約に係る顧客が当該有価証券の発行者又は所有者である場合に限る。）"}], "predictedAnswer": "D", "goldAnswer": "D", "llmUsed": true, "validationError": null, "llmError": null, "referenceScorable": false, "rerankerUsed": true, "rerankerModel": "hotchpotch/japanese-reranker-base-v2", "rerankerLatencyMs": 7010, "rerankerError": null, "llmCallCount": 3, "elapsedMs": 56108, "agentStopReason": "evidence_sufficient", "answerLlmStopReason": "end_turn", "plannerStopReason": "end_turn", "evaluatorStopReason": "end_turn", "questionPolarity": "select_contradicted", "choiceAssessments": {"A": {"verdict": "entailed", "citationIds": ["guidance-fsa-financial-instruments-business-page-139-chunk-316"], "reason": "監督指針①「金商法第37条の4に規定する契約締結時等の情報の提供をすべき事項」に対応し、通知していない場合は第123条第1項第8号に該当するとされる。"}, "B": {"verdict": "entailed", "citationIds": ["guidance-fsa-financial-instruments-business-page-139-chunk-316"], "reason": "監督指針②「入札成立後における当該取引に係る銘柄、単価及び金額」に一致し、通知していない場合は該当するとされる事項。"}, "C": {"verdict": "entailed", "citationIds": ["guidance-fsa-financial-instruments-business-page-139-chunk-316"], "reason": "監督指針③に対応し、顧客の同意がない場合は「当該事実及び当該取引の成否に係る事項」を通知しないと第123条第1項第8号に該当するとされる。"}, "D": {"verdict": "contradicted", "citationIds": ["guidance-fsa-financial-instruments-business-page-139-chunk-316"], "reason": "監督指針④のただし書きにより、顧客との間で直接金銭・有価証券の受渡しを行わない場合における当該受渡しに関する事項は通知義務の対象から除外されており、第123条第1項第8号には該当しない。"}}, "scores": {"answerAccuracy": 1, "