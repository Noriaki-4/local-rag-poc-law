# Local default.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
PLANNER_MODEL=gemma4:e4b
ANSWER_MODEL=gemma4:e4b
JUDGE_MODEL=none
LLM_TIMEOUT_SEC=90
LLM_MAX_CONTEXT_CHARS=4000
AGENT_USE_BM25=true
AGENT_USE_VECTOR=true
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SEC=120
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_CHARS=1000

# Claude / Anthropic option.
# 利用可能なモデルIDはAPIキーの契約プランに依存する。事前に動作確認すること。
# 拡張思考(thinking)対応モデルは thinking ブロックが max_tokens を消費するため、
# ANTHROPIC_MAX_TOKENS は 4096 未満にしない(RUNBOOK.md 9節参照)。
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_VERSION=2023-06-01
# ANTHROPIC_MAX_TOKENS=4096
# ANSWER_MODEL=claude-haiku-4-5-20251001

# Eval input options.
# Leave blank to use docs/requirements/samples/eval/lawqa_eval_item.sample.jsonl.
# LAWQA_EVAL_URL=https://raw.githubusercontent.com/digital-go-jp/lawqa_jp/main/data/selection.json
# LAWQA_EVAL_PATH=/workspace/datasets/lawqa_jp/data/selection.json
# EVAL_LIMIT=0
# EVAL_OFFSET=0
# EVAL_PATTERN=pattern_2_rule_based_agentic_rag
# EVAL_SKIP_SEED=false
# REQUEST_TIMEOUT_SEC=120

# Optional e-Gov corpus seeding for lawqa_jp all-question evaluation.
# SEED_LAWQA_EGOV=true
# EGOV_API_BASE_URL=https://laws.e-gov.go.jp/api/1
# LAWQA_EGOV_LAW_IDS=
