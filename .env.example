# Local default.
OPENSEARCH_INDEX=legal-rag-content-ja-v2
OPENSEARCH_INDEX_MAPPING=metadata/opensearch_index_mapping.japanese.sample.json
LLM_PROVIDER=ollama
LLM_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
PLANNER_MODEL=
ANSWER_MODEL=
REVIEWER_MODEL=
JUDGE_MODEL=none
LLM_TIMEOUT_SEC=90
LLM_MAX_CONTEXT_CHARS=12000
LLM_FINALIZATION_MATERIAL_MAX_ITEMS=24
AGENT_USE_BM25=true
AGENT_USE_VECTOR=true
AGENT_USE_LLM_PLANNER=true
AGENT_MAX_QUERIES=5
AGENT_MAX_RETRY_ROUNDS=1
AGENT_MAX_TOTAL_TOOL_CALLS=8
AGENT_MAX_GRAPH_HOP=1
AGENT_MAX_GRAPH_PATHS=10
AGENT_MAX_WALL_TIME_SEC=110
AGENT_ANSWER_RESERVE_SEC=60
AGENT_ISSUE_COVERAGE_SELECTION=false
AGENT_ISSUE_COVERAGE_SHADOW=true
AGENT_CANDIDATE_TOP_K=20
AGENT_GUIDANCE_CANDIDATE_TOP_K=10
AGENT_RERANK_TOP_K=16
AGENT_RRF_K=60
AGENT_MAX_LLM_CALLS=3
RERANK_PROVIDER=local_http
RERANK_BASE_URL=http://reranker-api:8100
RERANK_MODEL=hotchpotch/japanese-reranker-base-v2
RERANK_CANDIDATE_TOP_K=30
RERANK_TIMEOUT_SEC=30
RERANK_MAX_CHARS=3000
RERANK_MAX_LENGTH=512
RERANK_BATCH_SIZE=8
RERANK_CPU_THREADS=4
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SEC=120
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_CHARS=1000

# Claude / Anthropic option.
# 利用可能なモデルIDはAPIキーの契約プランに依存する。事前に動作確認すること。
# 拡張思考(thinking)対応モデルは thinking ブロックが max_tokens を消費するため、
# ANTHROPIC_MAX_TOKENS は 16384 程度を確保する。8192 では引用を多く渡した設問で
# 思考だけで枠を使い切り、本文が返らないことを実測(RUNBOOK.md 9節参照)。
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_VERSION=2023-06-01
# ANTHROPIC_MAX_TOKENS=16384
# ANTHROPIC_MAX_TOKENS_CEILING=32768
# PLANNER_MODEL=claude-haiku-4-5-20251001
# PLANNER_MAX_TOKENS=1024
# PLANNER_TIMEOUT_SEC=30
# EVALUATOR_MODEL=claude-haiku-4-5-20251001
# EVALUATOR_MAX_TOKENS=1024
# EVALUATOR_TIMEOUT_SEC=20
# ANSWER_MODEL=claude-haiku-4-5-20251001
# REVIEWER_MODEL=claude-haiku-4-5-20251001
# REVIEWER_MAX_TOKENS=8192

# OpenAI option. ChatGPTのサブスクリプションとは別にAPIキーとAPI利用料金が必要。
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MAX_TOKENS_CEILING=16384
# LLM_MODEL未指定時だけ、ANSWER_MODEL等の役割別設定を利用する。

# ---------------------------------------------------------------------------
# LLM主導の法令調査
# activeはLLMが検索・追加取得・最終根拠選択を行い、その証拠を回答生成へ接続する。
# ---------------------------------------------------------------------------
# AGENT_LLM_DIRECTED_RETRIEVAL=false
# AGENT_LLM_DIRECTED_RETRIEVAL_SHADOW=false
# LLM_RESEARCH_MODEL=claude-sonnet-5
# LLM_RESEARCH_STAGE_MODEL=claude-haiku-4-5-20251001
# LLM_RESEARCH_INTEGRATION_MODEL=claude-sonnet-5
# LLM_RESEARCH_MAX_TOKENS=4096
# LLM_RESEARCH_STAGE_EFFORT=low
# LLM_RESEARCH_INTEGRATION_MAX_TOKENS=8192
# LLM_RESEARCH_INTEGRATION_EFFORT=low
# 通常検索では未使用。検索時方式との比較評価用オフライン分類ツールの設定。
# 検索・回答用がAnthropicでも、この処理だけローカルOllamaを利用できる。
# RELATION_CLASSIFIER_PROVIDER=ollama
# RELATION_CLASSIFIER_MODEL=gemma4:e4b
# RELATION_CLASSIFIER_REVIEWER_MODEL=gemma4:e4b
# RELATION_CLASSIFIER_CONTEXT_TOKENS=131072
# 既定は意味判断の候補間干渉を避けるため1。2以上は速度比較用。
# RELATION_CLASSIFIER_BATCH_SIZE=1
# RELATION_CLASSIFIER_BATCH_CHARS=30000
# RELATION_CLASSIFIER_MAX_TOKENS=4096
# RELATION_CLASSIFIER_TIMEOUT_SEC=120
# LLM_RESEARCH_TIMEOUT_SEC=90
# LLM_RESEARCH_MAX_TURNS=3
# LLM_RESEARCH_MAX_ACTIONS_PER_TURN=4
# LLM_RESEARCH_MAX_TOOL_CALLS=18
# LLM_RESEARCH_SEARCH_TOP_K=8
# LLM_RESEARCH_DOCUMENT_SEARCH_TOP_K=30
# LLM_RESEARCH_MAX_CHUNKS_PER_ARTICLE=100
# LLM_RESEARCH_ACTIVE_BUDGET_SEC=360
# LLM_RESEARCH_SHADOW_BUDGET_SEC=180
# LLM_RESEARCH_MAX_EVIDENCE_ITEMS=60
# LLM_RESEARCH_MAX_SELECTED_EVIDENCE=16
# LLM_RESEARCH_EVIDENCE_CHARS=30000

# ---------------------------------------------------------------------------
# 新しい汎用Agent Framework
# /answerの切替前もPOST /answer/frameworkで明示検証できる。
# Reviewerは明示的にtrueへ変更しない限り呼ばれない。
# ---------------------------------------------------------------------------
# AGENT_FRAMEWORK_ACTIVE=false
# AGENT_FRAMEWORK_REVIEWER_ENABLED=false
# AGENT_FRAMEWORK_RESEARCH_MODEL=claude-haiku-4-5-20251001
# AGENT_FRAMEWORK_INTEGRATION_MODEL=claude-haiku-4-5-20251001
# AGENT_FRAMEWORK_REVIEWER_MODEL=claude-haiku-4-5-20251001
# AGENT_FRAMEWORK_RESEARCH_MAX_TOKENS=4096
# AGENT_FRAMEWORK_INTEGRATION_MAX_TOKENS=8192
# AGENT_FRAMEWORK_REVIEWER_MAX_TOKENS=8192
# AGENT_FRAMEWORK_MODEL_TIMEOUT_SEC=90
# AGENT_FRAMEWORK_MAX_RESEARCH_CYCLES=4
# AGENT_FRAMEWORK_MAX_TOOL_REQUESTS_PER_STEP=5
# AGENT_FRAMEWORK_MAX_FETCHED_RESOURCES_PER_CYCLE=3
# AGENT_FRAMEWORK_MAX_SELECTED_FRONTIER_PER_STEP=3
# AGENT_FRAMEWORK_MAX_GRAPH_CANDIDATES_PER_REVIEW_BATCH=20
# AGENT_FRAMEWORK_MAX_PARALLEL_TOOLS=4
# AGENT_FRAMEWORK_MAX_RETAINED_EVIDENCE=12
# AGENT_FRAMEWORK_MAX_MATERIAL_EVIDENCE_CHARS=50000
# AGENT_FRAMEWORK_MAX_SOLVER_INPUT_CHARS=240000
# AGENT_FRAMEWORK_CYCLE_CLOSE_RESERVE_SEC=15
# AGENT_FRAMEWORK_MIN_NEXT_CYCLE_BUDGET_SEC=25
# AGENT_FRAMEWORK_FINALIZATION_RESERVE_SEC=35
# AGENT_FRAMEWORK_MAX_WALL_TIME_SEC=240
# AGENT_FRAMEWORK_REVIEWER_MAX_REVISIONS=1

# Eval input options.
# Leave blank to use docs/samples/eval/lawqa_eval_item.sample.jsonl.
# LAWQA_EVAL_URL=https://raw.githubusercontent.com/digital-go-jp/lawqa_jp/main/data/selection.json
# LAWQA_EVAL_PATH=/workspace/datasets/lawqa_jp/data/selection.json
# EVAL_LIMIT=0
# EVAL_OFFSET=0
# EVAL_PATTERN=pattern_4_deepsearch
# EVAL_SKIP_SEED=false
# 評価クライアントの待ち時間。AGENT_MAX_WALL_TIME_SEC(既定110秒)より安全マージン以上
# 長くする。短いと「時間はかかったが正しく返ってきた回答」をクライアントが捨てる。
# REQUEST_TIMEOUT_SEC=150
# agent wall timeに対して要求する安全マージン(秒)。これを満たさない場合、eval-runnerは
# 評価を開始せず設定エラーにする(layered_legal_evidence_retrieval_plan.md §11.2)。
# REQUEST_TIMEOUT_SAFETY_MARGIN_SEC=10

# Optional e-Gov corpus seeding for lawqa_jp all-question evaluation.
# SEED_LAWQA_EGOV=true
# EGOV_API_BASE_URL=https://laws.e-gov.go.jp/api/1
# LAWQA_EGOV_LAW_IDS=

# Optional local corpus of non-e-Gov guidance referenced by lawqa_jp.
# Create it with scripts/download_lawqa_guidance.sh before enabling this.
# SEED_EXTERNAL_GUIDANCE=true
# EXTERNAL_GUIDANCE_MANIFEST=/workspace/datasets/lawqa_jp/external-guidance/manifest.json
# EXTERNAL_GUIDANCE_CHUNK_CHARS=900

# ---------------------------------------------------------------------------
# 法令レイヤー・法的役割別の根拠探索 vNext
# docs/layered_legal_evidence_retrieval_plan.md
# 既定はshadowも無効。有効化すると現行回答は変えずtrace(layeredLegalRetrieval)へ
# 論点・Requirement・Article候補・最終コンテキスト候補を記録する。
# activeへの切替はPhase 6の評価(20問・lawqa_jp 140問)の合格後に行う。
# ---------------------------------------------------------------------------
# AGENT_LAYERED_LEGAL_RETRIEVAL=false
# AGENT_LAYERED_LEGAL_RETRIEVAL_SHADOW=true

# 上限値は計画書 §11.1 の初期値案。Phase 0の実測後に確定する。
# LAYERED_MAX_PRIMARY_ISSUES=8
# LAYERED_ACTIVE_ISSUE_BATCH_SIZE=4
# LAYERED_MAX_REQUIREMENTS_TOTAL=24
# LAYERED_MAX_LEGAL_HOPS=3
# LAYERED_MAX_EXPANSION_ROUNDS=3
# LAYERED_MAX_ARTICLES_PER_REQUIREMENT=8
# LAYERED_MAX_ACCEPTED_ARTICLES_PER_REQUIREMENT=2
# LAYERED_MAX_CHILD_RELATIONS_PER_ARTICLE=6
# LAYERED_MAX_ARTICLE_CANDIDATES_TOTAL=64
# Cross-Encoderのペア上限はPhase 0の実測で確定する(暫定値)。
# LAYERED_MAX_RERANK_PAIRS_PER_CALL=16
# LAYERED_MAX_RERANK_PAIRS_TOTAL=64
# LAYERED_MAX_RERANK_CALLS_PER_ROUND=2
# LAYERED_MAX_RERANK_CALLS_TOTAL=8
# LAYERED_MAX_SEARCH_BATCH_CALLS_PER_ROUND=2
# LAYERED_MAX_SEARCH_BATCH_CALLS_TOTAL=8
# LAYERED_MAX_GRAPH_BATCH_CALLS_PER_ROUND=2
# LAYERED_MAX_GRAPH_BATCH_CALLS_TOTAL=8
# LAYERED_MAX_EMBEDDING_BATCH_CALLS_PER_ROUND=1
# LAYERED_MAX_EMBEDDING_BATCH_CALLS_TOTAL=4
# LAYERED_MAX_CHUNKS_PER_ARTICLE=3
# 24chunksはLLM_MAX_CONTEXT_CHARSを再設定してからだけ検討する(§11.5)。
# LAYERED_FINAL_CONTEXT_CHUNKS=16
# LAYERED_MAX_AUXILIARY_CONTEXT_CHUNKS=2
# LAYERED_MAX_GUIDANCE_PER_ISSUE=5
# LAYERED_MAX_GUIDE_DERIVED_ARTICLES=6
# LAYERED_MAX_REPLAN_CALLS=1
# shadowが回答前の安全余白を使い切らないための上限(§11.3)。
# LAYERED_SHADOW_PHASE_BUDGET_SEC=20
# LAYERED_SHADOW_REMAINING_FRACTION=0.5
# 採用profile名。Phase 0の実測後に明示する(未設定なら実値から推定)。
# AGENT_TIME_PROFILE_NAME=
