# Local default.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
PLANNER_MODEL=gemma4:e4b
ANSWER_MODEL=gemma4:e4b
JUDGE_MODEL=none
LLM_TIMEOUT_SEC=90
LLM_MAX_CONTEXT_CHARS=4000

