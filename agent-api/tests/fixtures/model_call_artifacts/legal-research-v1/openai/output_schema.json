          "description": "前提Hypothesisが否定されたときの子WorkItemの維持・置換・破棄。",
          "items": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "description": "retainは問いを維持して前提だけ更新、replaceは別の問いへ置換、dropは質問への回答に不要として終了。",
                "enum": [
                  "retain",
                  "replace",
                  "drop"
                ],
                "type": "string"
              },
              "drop_subtree": {
