{
  "$defs": {
    "DependencyDecision": {
      "additionalProperties": false,
      "properties": {
        "action_request_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "needs_actionを現在stepで実行するToolRequest ID。次Cycleへ送る場合はnull。",
          "title": "Action Request Id"
        },
        "basis_evidence_ids": {
          "default": [],
          "description": "この状態判断に使用した取得済みgrounding Evidence ID。",
          "items": {
            "type": "string"
          },
          "title": "Basis Evidence Ids",
          "type": "array"
        },
        "dependency_kind": {
          "description": "確認対象となる下位規範依存の種類。",
          "maxLength": 160,
          "minLength": 1,
          "title": "Dependency Kind",
          "type": "string"
        },
        "reason": {
          "description": "statusを選んだ本文に基づく短い理由。",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "description": "not_requiredは下位規範確認不要、needs_actionは追加探索必要、resolvedは委任元と末端の本文確認済み。",
          "enum": [
            "not_required",
            "needs_action",
            "resolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "work_item_id": {
          "description": "この依存判断が属する既知WorkItem ID。",
          "maxLength": 160,
          "minLength": 1,
          "title": "Work Item Id",
          "type": "string"
        }
      },
      "required": [
        "dependency_kind",
        "work_item_id",
        "status",
        "reason"
      ],
      "title": "DependencyDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision_reason": {
      "description": "下位規範の末端本文確認状態を判断した短い説明。",
      "maxLength": 1200,
      "minLength": 1,
      "title": "Decision Reason",
      "type": "string"
    },
    "dependency_decisions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DependencyDecision"
      },
      "title": "Dependency Decisions",
      "type": "array"
    }
  },
  "required": [
    "decision_reason"
  ],
  "title": "DependencyAssessmentDecision",
  "type": "object"
}
