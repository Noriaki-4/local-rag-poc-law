{
  "name": "local-rag-law-aws-infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "test": "jest --runInBand",
    "synth": "npm run build && cdk synth --no-validation -c offline=true",
    "synth:aws": "npm run build && cdk synth",
    "diff": "npm run build && cdk diff",
    "deploy": "npm run build && cdk deploy",
    "format": "prettier --write 'bin/**/*.ts' 'lib/**/*.ts' 'test/**/*.ts' '*.json'",
    "format:check": "prettier --check 'bin/**/*.ts' 'lib/**/*.ts' 'test/**/*.ts' '*.json'"
  },
  "dependencies": {
    "aws-cdk-lib": "2.267.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "24.10.1",
    "aws-cdk": "2.1139.0",
    "jest": "29.7.0",
    "prettier": "3.4.2",
    "ts-jest": "29.2.5",
    "typescript": "5.9.3"
  }
}
